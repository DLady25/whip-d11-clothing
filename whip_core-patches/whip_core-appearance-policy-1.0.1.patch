+// ========================================
+// D11 PATCH appearance-policy: THE STORE'S CART
+//
+// An editor a store opened (openCreator's `checkout`) keeps a cart on the right: every part changed since it
+// opened, priced by the server (quoteAppearance -> the store's onQuote), each with a button that puts that part
+// back as it was. The total, cash or bank, and the buy button save through the store (saveAppearance with
+// `method`). The look is checked every 600 ms and asked again only when it changed. `checkout` may carry the
+// store's own words for the cart (CART_TEXT keys); what it leaves out is in English.
+// ========================================
+
+const CART_TEXT = {
+    cart: 'Cart', free: 'Free', remove: 'Remove', empty: 'Nothing changed yet. Pick on the left.', total: 'Total',
+    cash: 'Cash', bank: 'Bank', buy: 'Buy', paying: 'Paying…', save: 'Save', short: 'Not enough money for this total.',
+    failed: 'The purchase did not go through', locale: 'en-US',
+};
+let cartText = CART_TEXT;
+let checkout = false;
+let cartBase = null;          // the look as the editor opened: what "remove" puts back
+let cartQuote = null;         // { title, total, lines = [{ label, price, key }], cash, bank }
+let cartMethod = null;        // 'cash' | 'bank'
+let cartSent = '';            // the look last asked about
+let cartTimer = null;
+let cartBusy = false;
+let cartWhy = '';
+
+const money = (n) => '$' + Math.round(Number(n) || 0).toLocaleString(cartText.locale || 'en-US');
+
+function cartEl() {
+    let el = document.getElementById('cr-cart');
+    if (!el) {
+        el = document.createElement('div');
+        el.id = 'cr-cart';
+        document.querySelector('#creator .cr-scale').appendChild(el);
+    }
+    return el;
+}
+
+function cartUsable(kind) {
+    const q = cartQuote || {};
+    const have = q[kind];
+    return typeof have === 'number' && have >= (q.total || 0);
+}
+
+function renderCart() {
+    const el = cartEl();
+    const t = cartText;
+    document.getElementById('creator').classList.toggle('has-cart', checkout);
+    const saveBtn = document.getElementById('cr-save');   // the cart's buy button is the only way out with a buy
+    if (saveBtn) saveBtn.style.display = checkout ? 'none' : '';
+    if (!checkout) { el.classList.remove('open'); el.innerHTML = ''; return; }
+    el.classList.add('open');
+    const q = cartQuote || { lines: [], total: 0 };
+    const rows = (q.lines || []).map(l => `<div class="cr-cart-row">
+        <span class="cr-cart-label">${escapeHtml(l.label || '')}</span>
+        <span class="cr-cart-price${l.price > 0 ? '' : ' free'}">${l.price > 0 ? money(l.price) : escapeHtml(t.free)}</span>
+        ${l.key ? `<button class="cr-cart-x" data-action="cartRemove" data-key="${escapeHtml(l.key)}" title="${escapeHtml(t.remove)}" aria-label="${escapeHtml(t.remove)}: ${escapeHtml(l.label || '')}">&times;</button>` : ''}
+    </div>`).join('');
+    const total = q.total || 0;
+    if (cartMethod && !cartUsable(cartMethod)) cartMethod = null;
+    if (!cartMethod) cartMethod = cartUsable('cash') ? 'cash' : (cartUsable('bank') ? 'bank' : null);
+    const method = (kind, label, have) => typeof have !== 'number' ? '' :
+        `<button class="cr-cart-pay${cartMethod === kind ? ' on' : ''}" data-action="cartMethod" data-value="${kind}"
+            ${cartUsable(kind) ? '' : 'disabled'} aria-pressed="${cartMethod === kind}">
+            <span>${escapeHtml(label)}</span><small>${money(have)}</small></button>`;
+    const pays = total > 0 ? `<div class="cr-cart-pays">${method('cash', t.cash, q.cash)}${method('bank', t.bank, q.bank)}</div>` : '';
+    const canBuy = !cartBusy && (total === 0 || !!cartMethod);
+    const buyLabel = cartBusy ? t.paying : (total > 0 ? `${t.buy} · ${money(total)}` : t.save);
+    el.innerHTML = `
+        <div class="cr-cart-head"><div class="cr-cart-title">${escapeHtml(t.cart)}</div>
+            <div class="cr-cart-sub">${escapeHtml(q.title || '')}</div></div>
+        <div class="cr-cart-list">${rows || `<div class="cr-cart-empty">${escapeHtml(t.empty)}</div>`}</div>
+        <div class="cr-cart-total"><span>${escapeHtml(t.total)}</span><b>${money(total)}</b></div>
+        ${pays}
+        ${cartWhy ? `<div class="cr-cart-why">${escapeHtml(cartWhy)}</div>` : ''}
+        ${total > 0 && !cartMethod ? `<div class="cr-cart-why">${escapeHtml(t.short)}</div>` : ''}
+        <button class="cr-cart-buy" data-action="cartBuy" ${canBuy ? '' : 'disabled'}>${escapeHtml(buyLabel)}</button>`;
+}
+
+function askCart(force) {
+    if (!checkout || !creatorOpen) return;
+    const look = collectAppearance();
