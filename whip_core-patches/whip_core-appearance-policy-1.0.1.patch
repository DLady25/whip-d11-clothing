+-- ============================================
+-- D11 PATCH appearance-policy (whip-d11-clothing, d11_stores)
+-- ============================================
+-- A store (d11_stores) opens the editor with only some categories and charges before it saves:
+--   server  exports.whip_core:SetAppearancePolicy(source, { allow = { 'tops', 'legs', 'hat', 'tattoos', ... },
+--               onQuote = function(source, old, new) return { ...the cart the editor shows... } end,
+--               onSave = function(source, old, new, { method }) return true | false, 'why' end })   -- nil clears it
+--   client  exports.whip_core:OpenCharacterEditor({ allow = {...}, title, sub, policy = true, texts = {...} })
+-- onQuote answers whip_core:appearance:quoteWithPolicy (the editor asks as the look changes) with whatever the
+-- page draws as its cart: { title, total, lines = { { label, price, key } }, cash, bank }. `key` names the part a
+-- line is ('c:11', 'p:0', 'hair', 'ov:beard', 'tat:<collection>/<overlay>', 'face'): the page puts it back.
+-- `cash` / `bank` are what the player has there, or false when the store does not take it.
+-- The save then comes as whip_core:appearance:saveWithPolicy: every part the policy does not allow is put back
+-- from the saved look, onSave runs (charge there), and only then is it kept. While a policy is set the plain
+-- saveAppearance is refused, so the store's save cannot be skipped. A policy lasts 30 minutes or one save.
+
+-- What each editor category (html/js/creator-data.js CATEGORIES ids; 'tattoos' = every tattoo part) changes.
+local POLICY_FIELDS = {
+    heritage = { top = { 'headBlend' } }, features = { top = { 'faceFeatures' } }, eyes = { top = { 'eyeColor' } },
+    hair = { top = { 'hair', 'hairFade' } },
+    eyebrows = { overlays = { 'eyebrows' } }, beard = { overlays = { 'beard' } },
+    makeup = { overlays = { 'makeup', 'blush', 'lipstick' } },
+    skin = { overlays = { 'blemishes', 'ageing', 'complexion', 'sunDamage', 'moles' } },
+    chestHair = { overlays = { 'chestHair' } },
+    mask = { components = { '1' } }, tops = { components = { '11' } }, undershirt = { components = { '8' } },
+    arms = { components = { '3' } }, legs = { components = { '4' } }, shoes = { components = { '6' } },
+    accessory = { components = { '7' } }, armor = { components = { '9' } }, decal = { components = { '10' } },
+    bag = { components = { '5' } },
+    hat = { props = { '0' } }, glasses = { props = { '1' } }, ear = { props = { '2' } }, watch = { props = { '6' } },
+    bracelet = { props = { '7' } },
+    tattoos = { top = { 'tattoos' } },
+    outfits = {},   -- the Saved tab only puts clothes on: what it may change is the clothing categories' business
+}
+local POLICY_TTL = 1800
+local appearancePolicies = {}   -- [source] = { allow = { [id] = true }, onSave, at }
+
+exports('SetAppearancePolicy', function(source, policy)
+    source = tonumber(source)
+    if not source then return false, 'no player' end
+    if policy == nil then appearancePolicies[source] = nil return true end
+    if type(policy) ~= 'table' or type(policy.allow) ~= 'table' then
+        return false, 'policy.allow is a list of editor categories'
+    end
+    local allow = {}
+    for _, id in ipairs(policy.allow) do
+        if not POLICY_FIELDS[id] then return false, 'unknown editor category: ' .. tostring(id) end
+        allow[id] = true
+    end
+    appearancePolicies[source] = { allow = allow, onSave = policy.onSave, onQuote = policy.onQuote, at = os.time() }
+    return true
+end)
+
+AddEventHandler('playerDropped', function() appearancePolicies[source] = nil end)
+
+--- `new` with every part the policy does not allow taken from `old` (a copy). The body never changes.
+local function keepDisallowed(new, old, allow)
+    new.model = old.model
+    for id, f in pairs(POLICY_FIELDS) do
+        if not allow[id] then
+            for _, key in ipairs(f.top or {}) do new[key] = old[key] end
+            for _, group in ipairs({ 'overlays', 'components', 'props' }) do
+                if f[group] then
+                    new[group] = new[group] or {}
+                    for _, key in ipairs(f[group]) do new[group][key] = (old[group] or {})[key] end
+                end
+            end
+        end
+    end
+    return new
+end
+
+--- The policy in force, and the look as it would be kept (sanitized, disallowed parts put back), or nil and why.
+local function policyLook(source, player, appearance)
+    local policy = appearancePolicies[source]
+    if not policy or os.time() - policy.at > POLICY_TTL then
+        appearancePolicies[source] = nil
+        return nil, nil, nil, 'The store visit is over. Open it again.'
+    end
+    local encoded = json.encode(appearance)
+    if not encoded or #encoded > 10000 then return nil, nil, nil, 'That look is too big' end
+    local clean, err = sanitizeAppearance(appearance)
+    if not clean then return nil, nil, nil, 'Look refused: ' .. (err or 'invalid') end
+    local old = player:getMetadata('appearance')
+    old = type(old) == 'table' and old.model and json.decode(json.encode(old)) or nil
+    if old then clean = keepDisallowed(clean, old, policy.allow) end
+    return policy, clean, old
+end
+
+-- The cart, asked again as the look changes (the editor polls; a look that did not change is not asked).
+SecureCallback('whip_core:appearance:quoteWithPolicy', {
+    rateLimit = 250, burst = 6,
+    params = { { 'appearance', 'any' } },
+}, function(source, player, appearance)
+    local policy, clean, old, why = policyLook(source, player, appearance)
+    if not policy then return false, why end
+    if not policy.onQuote then return { total = 0, lines = {} } end
+    local ran, quote = pcall(policy.onQuote, source, old, clean)
+    if not ran or type(quote) ~= 'table' then
+        print(('[whip_core:appearance] a store\'s onQuote failed: %s'):format(tostring(quote)))
+        return false, 'The store did not answer.'
+    end
+    return quote
+end)
+
+SecureCallback('whip_core:appearance:saveWithPolicy', {
+    rateLimit = 2000,
+    params = { { 'appearance', 'any' }, { 'method', 'string', 8, '' } },
+}, function(source, player, appearance, method)
+    local policy, clean, old, why = policyLook(source, player, appearance)
+    if not policy then return false, why end
+
+    if policy.onSave then
+        local ran, ok, why = pcall(policy.onSave, source, old, clean, { method = method })
+        if not ran then
+            print(('[whip_core:appearance] a store\'s onSave failed: %s'):format(tostring(ok)))
+            return false, 'The store did not answer. Try again.'
+        end
+        if ok == false then return false, type(why) == 'string' and why or 'Not saved' end
+    end
+
+    appearancePolicies[source] = nil
+    player:setMetadata('appearance', clean)
+    player:save()
+    return clean
+end)
+
 SecureEvent('whip_core:server:saveAppearance', {
     rateLimit = 2000,
     params = { {'appearance', 'any'} },
 }, function(source, player, appearance)
+    -- D11 PATCH appearance-policy: a store's editor saves through saveWithPolicy (its check and charge).
+    if appearancePolicies[source] then return false, 'Save through the store\'s cart' end
+
     -- Byte cap first — no point walking a table whose encoding is absurd.
