+    } else if (key === 'hair') {
+        a.hair = copy(b.hair); a.hairFade = b.hairFade ? copy(b.hairFade) : null;
+    } else if (key.startsWith('ov:')) {
+        a.overlays[key.slice(3)] = copy(b.overlays[key.slice(3)]);
+    } else if (key.startsWith('tat:')) {
+        const k = key.slice(4);
+        a.tattoos = a.tattoos.filter(t => (t.collection + '/' + t.overlay) !== k);
+    } else if (key === 'face') {
+        a.headBlend = copy(b.headBlend); a.faceFeatures = copy(b.faceFeatures); a.eyeColor = b.eyeColor;
+        ['blemishes', 'ageing', 'complexion', 'sunDamage', 'moles'].forEach(k => { a.overlays[k] = copy(b.overlays[k]); });
+    } else return;
+    schedulePreview();
+    if (activeCategory) { renderGrid(); renderOptions(); }
+    askCart(true);
+}
+
+function cartBuy() {
+    if (cartBusy) return;
+    const total = (cartQuote && cartQuote.total) || 0;
+    if (total > 0 && !cartMethod) return;
+    cartBusy = true; cartWhy = '';
+    renderCart();
+    nuiCallback('saveAppearance', { appearance: collectAppearance(), method: total > 0 ? cartMethod : '' }).then(r => {
+        cartBusy = false;
+        if (!r || r.ok === false) { cartWhy = (r && r.why) || cartText.failed; askCart(true); }
+        renderCart();
+    });
+}
