+}
+
+function startCart(on) {
+    checkout = !!on;
+    cartText = Object.assign({}, CART_TEXT, on && typeof on === 'object' ? on : {});
+    cartQuote = null; cartMethod = null; cartSent = ''; cartBusy = false; cartWhy = '';
