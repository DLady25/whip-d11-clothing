+-- D11 PATCH creator-photostudio: the creator's camera for another resource (d11_photostudio, whose page cannot
+-- reach this page's callbacks). One table, any of: lock (true/false, see camLockH), stage (-1..1, where the ped
+-- stands across the screen, 0 = centre), preset (a framing), yaw, turn, and pan / orbitX / zoom as camInput takes.
+exports('CreatorCamera', function(o)
+    if not CreatorLive() or type(o) ~= 'table' then return false end
+    if o.lock ~= nil then camLockH = o.lock and GetEntityHeading(PlayerPedId()) or nil end
+    if o.stage ~= nil then
+        tShiftX = clampN(tonumber(o.stage) or 0.0, -0.8, 0.8)
+        if camPhase == 'enter' then camShiftX = tShiftX end
+    end
+    if type(o.preset) == 'string' then ApplyCamFraming(o.preset) end
+    local yaw, turn = tonumber(o.yaw), tonumber(o.turn)
+    if yaw and yaw > -3600.0 and yaw < 3600.0 then tYaw = wrap180(yaw) end
+    if turn and turn > -360.0 and turn < 360.0 then tYaw = wrap180(tYaw + turn) end
+    local function lim(v, n) return math.max(-n, math.min(n, tonumber(v) or 0.0)) end
+    if o.pan or o.orbitX or o.zoom then CamInput(lim(o.pan, 400.0), lim(o.orbitX, 400.0), 0.0, lim(o.zoom, 20.0)) end
+    return true
+end)
+
